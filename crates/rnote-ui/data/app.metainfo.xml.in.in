<?xml version="1.0" encoding="UTF-8"?>
<!-- OnePepe (Pepe Flock). Basado en el archivo de Rnote, de Felix Zwettler 2022. -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name translatable="no">@APP_NAME_CAPITALIZED@</name>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <summary>Handwritten notes and math for studying science</summary>

  <categories>
    <category>Graphics</category>
    <category>Education</category>
    <category>Office</category>
    <category>VectorGraphics</category>
    <category>GNOME</category>
    <category>GTK</category>
  </categories>

  <description>
    <p>
      OnePepe, from Pepe Flock, is a handwritten notes app for studying science, based on Rnote:
      notebooks, ink to shape, a ruler and a math mode that learns your handwriting.
    </p>
    <p>
      Disclaimer: The file format is still unstable. It might change and break compatibility between
      versions.
    </p>
  </description>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/merinodpepe/OnePepe/main/misc/onepepe/diseno/despues-claro.png</image>
      <caption>Notebooks, ribbon and ink</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/merinodpepe/OnePepe/main/misc/onepepe/diseno/despues-oscuro.png</image>
      <caption>Dark mode</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/merinodpepe/OnePepe/main/misc/onepepe/diseno/regla-infinita.png</image>
      <caption>Infinite ruler with free angle</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/merinodpepe/OnePepe/main/misc/onepepe/diseno/renglones.png</image>
      <caption>Lined pages with a margin</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/merinodpepe/OnePepe/main/misc/onepepe/diseno/ajustes-apariencia.png</image>
      <caption>Appearance settings</caption>
    </screenshot>
  </screenshots>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
    <control>tablet</control>
    <display_length compare="ge">500</display_length>
  </recommends>

  <url type="homepage">@APP_WEBSITE@</url>
  <url type="bugtracker">@APP_ISSUES_URL@</url>
  <url type="vcs-browser">@APP_REPO_URL@</url>
  <developer_name translatable="no">@APP_AUTHOR_NAME@</developer_name>
  <content_rating type="oars-1.0" />

  <provides>
    <binary>@APP_NAME@</binary>
  </provides>

  <!-- The changelog should not be translated -->
  <releases>
    <release version="1.3.3" date="2026-10-31">
      <description>
        <p>Fixed: tapping the "?" after an "=" closed the app.</p>
      </description>
    </release>
    <release version="1.3.2" date="2026-10-31">
      <description>
        <p>If the app closes because of an error, a report is saved and the next start says where it is.</p>
      </description>
    </release>
    <release version="1.3.1" date="2026-10-31">
      <description>
        <p>The math helper is started by its full path inside Flatpak, and the app says so when it does not answer.
          Wrong steps are marked under their line.</p>
      </description>
    </release>
    <release version="1.3.0" date="2026-10-30">
      <description>
        <p>A training set with population genetics, biophysics and statistical learning; choose the set when a
          training starts. Statistics symbols: hats, bars, expectation, probability, transpose. A biophysics
          glossary with constants and units.</p>
      </description>
    </release>
    <release version="1.2.0" date="2026-10-30">
      <description>
        <p>Training mode: write 200 known expressions in a box to teach your handwriting to the math recognizer.
          Saved in its own training file, so you can stop and go on another day.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-10-30">
      <description>
        <p>Math mode fixes (writing next to symbols, zoom, i and j, functions, the result of "="), recognize a
          selection, write the symbol yourself, scratch-out, variables, step check, copy as LaTeX, fractions and
          plots. The version is shown in the status bar.</p>
      </description>
    </release>
    <release version="0.15.0" date="2026-10-29">
      <description>
        <p>First OnePepe release: notebooks with subpages, OneNote-style ribbon, favorite pens, text styles,
          infinite ruler, lined pages, math mode, light and dark themes. Based on Rnote 0.14.2.</p>
      </description>
    </release>
  </releases>
  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#613583</color>
  </branding>
</component>
